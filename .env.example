# ==============================================================================
# VyaparVoice Environment Configuration
# Copy this file to .env.local and populate your secrets.
# NEVER commit .env.local or expose your SARVAM_API_KEY in client-side code!
# ==============================================================================

# Sarvam AI API Key (Get from https://dashboard.sarvam.ai/)
# If empty or not set, VyaparVoice runs in full, transparent DEMO MODE with deterministic examples.
SARVAM_API_KEY=

# Optional Overrides (default values shown)
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4
