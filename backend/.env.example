# ==============================================================================
# BhashaVoice AI - Python FastAPI Backend Environment Configuration
# Copy this file to backend/.env and customize as needed.
# ==============================================================================

# Server settings
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_ENV=development

# CORS allowed origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Whisper Model Configuration (faster-whisper)
# Model size: "tiny", "base", "small", "medium", "large-v3"
# For research prototype and quick startup, "tiny" is used by default.
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_DOWNLOAD_ROOT=

# Audio validation limits (bytes)
# 25 MB = 26,214,400 bytes
MAX_AUDIO_SIZE_BYTES=26214400

# Optional Sarvam AI Key (for hybrid STT/TTS routing)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

